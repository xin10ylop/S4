# Copy this file to bot/.env (chmod 600) and fill in real values.
# bot/.env is git-ignored — NEVER commit real secrets.
#
# PAPER mode (the default) needs none of these.

# --- LIVE mode gate (see polybot/execution.py) -----------------------------
# Real orders require config.yaml `mode.paper: false` AND POLYBOT_LIVE=1 AND
# POLYBOT_PK present. Missing any one of these keeps the bot in paper mode.
POLYBOT_LIVE=0
POLYBOT_PK=

# Wallet / signing configuration for the live py-clob-client path.
# signature_type: 0=EOA (raw wallet), 1=POLY_PROXY (email/magic wallet),
# 2=POLY_GNOSIS_SAFE (browser wallet proxy). funder is required for 1/2.
POLYBOT_SIGNATURE_TYPE=0
POLYBOT_FUNDER=
POLYBOT_CHAIN_ID=137

# --- networking --------------------------------------------------------
# CA bundle for TLS verification. Leave unset on a normal server (uses the
# system trust store). In a sandboxed dev environment behind a proxy, this
# defaults to /root/.ccr/ca-bundle.crt automatically if that file exists.
POLYBOT_CA_BUNDLE=

# HTTP status server port (default 8899).
POLYBOT_PORT=8899
